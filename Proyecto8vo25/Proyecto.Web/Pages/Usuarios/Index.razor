@page "/user"
@using Proyecto.Shared.Entidad;
@using static System.Net.WebRequestMethods
@inject NavigationManager navegar
@inject HttpClient Http

<h2>Usuarios</h2> 
<div class="mb-3">
    <a class="btn btn-primary" href="/usuario/crear">Nuevo Usuario</a>
</div>
<body>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Acciones</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Carnet</th>
                <th>Correo</th>
            </tr>
        </thead>
        <tbody>
             @foreach (var u in usuarios)
            {
                <tr>
                    <td>
                        <a class="btn btn-warning" href="/user/editar/@u.Id">Editar</a>
                        <button class="btn btn-danger" onclick=@(() => Delete(u))>Borrar</button>
                    </td>
                    <td>
                         @u.NombreCompleto
                    </td>
                    <td>
                        @u.FechaNac
                    </td>
                    <td>
                        @u.LugarNac
                    </td>
                    <td>
                        @u.Profesion
                    </td>
                    <td>
                        @u.EstadoCivil
                    </td>
                    <td>
                        @u.Domicilio
                    </td>
                </tr>
            } 
        </tbody>
    </table>
</body>

@code {
    public List<Usuario> usuarios { get; set; } = new();
    private Usuario? usuario;


    protected async override Task OnInitializedAsync()
    {
        usuarios = await Http.GetFromJsonAsync<List<Usuario>>("/api/usuarios");
    }

    private async Task Delete(Usuario usuario)
    {
        var resultado = await Http.DeleteAsync($"/api/usuarios/{usuario.Id}");
        StateHasChanged();
        navegar.NavigateTo("/user");
    }

   

}
 